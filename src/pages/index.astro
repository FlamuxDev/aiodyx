---
import '../styles/tokens.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import { abs, asset, href } from '../lib/site';
// Static redirect to the default market (Arabic) + a no-JS language chooser.
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AIODYX</title>
    <meta http-equiv="refresh" content={`0; url=${href('ar')}`} />
    <link rel="canonical" href={abs(href('ar'))} />
    <link rel="alternate" hreflang="ar" href={abs(href('ar'))} />
    <link rel="alternate" hreflang="en" href={abs(href('en'))} />
    <link rel="alternate" hreflang="x-default" href={abs(href('ar'))} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="chooser">
    <main>
      <h1 class="sr">AIODYX</h1>
      <Logo class="chooser__logo" />
      <p class="chooser__row">
        <a class="btn btn--primary btn--lg" href={href('ar')} lang="ar">العربية</a>
        <a class="btn btn--ghost btn--lg" href={href('en')} lang="en" dir="ltr">English</a>
      </p>
    </main>
  </body>
</html>
