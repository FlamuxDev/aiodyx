---
import '../styles/tokens.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import { asset, href } from '../lib/site';
// Generic 404 for hosts that serve /404.html: bilingual, no language guess.
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | AIODYX</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="chooser">
    <main>
      <Logo class="chooser__logo" />
      <h1>404</h1>
      <p lang="ar">الصفحة مو موجودة</p>
      <p lang="en" dir="ltr">Page not found</p>
      <p class="chooser__row">
        <a class="btn btn--primary btn--lg" href={href('ar')} lang="ar">العربية</a>
        <a class="btn btn--ghost btn--lg" href={href('en')} lang="en" dir="ltr">English</a>
      </p>
    </main>
  </body>
</html>
