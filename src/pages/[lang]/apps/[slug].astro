---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import AppMock from '../../../components/mocks/AppMock.astro';
import PageHead from '../../../components/PageHead.astro';
import SectionHead from '../../../components/SectionHead.astro';
import AppTiles from '../../../components/AppTiles.astro';
import LinkList from '../../../components/LinkList.astro';
import Faq from '../../../components/Faq.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { DATA, abs, href, tel, waUrl, pathsFor, slugs, type Lang } from '../../../lib/site';
import { faqNode, serviceNode } from '../../../lib/schema';

export const getStaticPaths = () => pathsFor(slugs.apps);
const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const d = DATA[lang];
const app = d.apps.find((a) => a.slug === slug)!;
const url = abs(href(lang, `apps/${slug}/`));
const industries = d.industries.filter((i) => (i.apps as string[]).includes(slug));
const others = d.apps.filter((a) => a.slug !== slug);
---
<Base lang={lang} path={`apps/${slug}/`} title={app.seo.title} description={app.seo.description} waTopic={app.name}
  crumbs={[{ name: d.site.nav.apps, href: href(lang, 'apps/') }, { name: app.name, href: href(lang, `apps/${slug}/`) }]}
  extra={[
    serviceNode({ id: `${url}#service`, name: app.name, description: app.seo.description, url, lang, type: 'Odoo implementation' }),
    faqNode(lang, url, app.faq),
  ]}>
  <PageHead title={app.name} lead={app.promise}>
    <p class="phead__for"><span class="label">{d.site.labels.appFor}</span>{app.for}</p>
    <div class="btn-row">
      <a class="btn btn--wa btn--lg" href={waUrl(lang, app.name)} rel="noopener"><Icon name="whatsapp" size={20} />{d.site.cta.whatsapp}</a>
      <a class="btn btn--line btn--lg" href={tel(d.offices[2].phone)}><Icon name="phone" size={20} />{d.site.cta.call}</a>
    </div>
    <AppMock slot="visual" slug={slug} lang={lang} />
  </PageHead>

  <section class="sec" aria-labelledby="feat">
    <div class="wrap">
      <SectionHead id="feat" title={d.site.labels.appFeatures} />
      <ul class="checks checks--2" role="list">
        {app.features.map((f) => <li><Icon name="check" size={18} /><span>{f}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="statement" aria-labelledby="out">
    <div class="wrap statement__in">
      <h2 id="out" class="eyebrow">{d.site.labels.appOutcome}</h2>
      <p>{app.outcome}</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="conn">
    <div class="wrap">
      <SectionHead id="conn" title={d.site.labels.appConnects} lead={app.connects} />
      <AppTiles lang={lang} apps={others} cols={4} />
    </div>
  </section>

  {industries.length > 0 && (
    <section class="sec sec--grey" aria-labelledby="inds">
      <div class="wrap">
        <SectionHead id="inds" title={d.site.nav.industries} href={href(lang, 'industries/')} label={d.site.cta.allIndustries} />
        <LinkList items={industries.map((i) => ({ href: href(lang, `industries/${i.slug}/`), label: i.name }))} />
      </div>
    </section>
  )}

  <section class={`sec ${industries.length > 0 ? '' : 'sec--grey'}`} aria-labelledby="faq">
    <div class="wrap split">
      <SectionHead id="faq" side title={d.site.labels.faq} />
      <Faq items={app.faq} />
    </div>
  </section>

  <CtaBand lang={lang} title={d.pages.apps.cta.title} body={d.pages.apps.cta.body} button={d.pages.apps.cta.button} topic={app.name} />
</Base>
