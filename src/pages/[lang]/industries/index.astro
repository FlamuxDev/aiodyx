---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import IndustryIcon from '../../../components/IndustryIcon.astro';
import AppIcon from '../../../components/AppIcon.astro';
import PageHead from '../../../components/PageHead.astro';
import SectionHead from '../../../components/SectionHead.astro';
import IndustryStreet from '../../../components/IndustryStreet.astro';
import IndustryScene from '../../../components/scenes/IndustryScene.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { DATA, href, langPaths, type Lang } from '../../../lib/site';

export const getStaticPaths = langPaths;
const { lang } = Astro.params as { lang: Lang };
const d = DATA[lang];
const p = d.pages.industries;
const n = (i: number) => String(i + 1).padStart(2, '0');
const short = (s: string) => s.split(/\s+و|\s*[&,]\s*/)[0];
// UI chrome: the quick matcher.
const M = {
  ar: {
    title: 'ما الوصف الأقرب لعملك؟',
    lead: 'اختر، لنعرض لك القطاع والتطبيقات المناسبة.',
    labels: { retail: 'أبيع للأفراد مباشرة', wholesale: 'أبيع بالجملة', manufacturing: 'أصنّع منتجات', services: 'أقدّم خدمات', construction: 'أنفّذ مشاريع', restaurants: 'أملك مطعمًا أو مقهى' } as Record<string, string>,
    see: 'استعرض القطاع',
    jump: 'انتقل إلى الشرح',
    painsLabel: 'هل تعاني من هذا؟',
  },
  en: {
    title: 'Which description fits your business best?',
    lead: 'Pick one and we will show the sector and the apps that suit you.',
    labels: { retail: 'I sell to people directly', wholesale: 'I sell wholesale', manufacturing: 'I make products', services: 'I provide services', construction: 'I deliver projects', restaurants: 'I run a restaurant or café' } as Record<string, string>,
    see: 'See the sector',
    jump: 'Jump to the story',
    painsLabel: 'Sound familiar?',
  },
}[lang];
const apps = (it: any) => (it.apps as string[]).map((s) => d.apps.find((a) => a.slug === s)!);
---
<Base lang={lang} path="industries/" title={p.seo.title} description={p.seo.description} crumbs={[{ name: d.site.nav.industries, href: href(lang, 'industries/') }]}>
  <PageHead title={p.intro.title} lead={p.intro.body}>
    <IndustryStreet slot="visual" lang={lang} />
  </PageHead>

  <nav class="indtabs" aria-label={d.site.nav.industries}>
    <ol class="indtabs__list">
      {d.industries.map((it) => (
        <li><a href={`#${it.slug}`} data-spy={it.slug}><IndustryIcon slug={it.slug} size={22} /><span>{it.name}</span></a></li>
      ))}
    </ol>
  </nav>

  {d.industries.map((it, i) => (
    <section class={`sec irow-sec ${i % 2 ? 'sec--grey' : ''}`} id={it.slug} data-row={it.slug} aria-labelledby={`h-${it.slug}`}>
      <div class={`wrap irow ${i % 2 ? 'irow--flip' : ''}`}>
        <div class="irow__scene"><IndustryScene slug={it.slug} lang={lang} /></div>
        <div class="irow__text">
          <p class="eyebrow">{n(i)}</p>
          <h2 id={`h-${it.slug}`} class="h-md"><a href={href(lang, `industries/${it.slug}/`)}>{it.name}</a></h2>
          <p class="irow__promise">{it.promise}</p>
          <div class="irow__pains">
            <p class="irow__label">{d.site.labels.industryPains}</p>
            <ul>
              {it.pains.slice(0, 3).map((t) => <li><span aria-hidden="true"><Icon name="close" size={14} /></span>{t}</li>)}
            </ul>
          </div>
          <div class="irow__fix">
            <p class="irow__label"><Icon name="arrow" size={16} />{d.site.labels.industryApps}</p>
            <ul class="achips" role="list">
              {apps(it).map((a) => <li><a href={href(lang, `apps/${a.slug}/`)}><AppIcon name={a.slug} size={26} />{short(a.name)}</a></li>)}
            </ul>
          </div>
          <a class="textlink" href={href(lang, `industries/${it.slug}/`)}>{d.site.cta.learnMore}<Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </section>
  ))}

  <section class={`sec ${d.industries.length % 2 ? 'sec--grey' : ''}`} id="match" aria-labelledby="h-match">
    <div class="wrap">
      <SectionHead id="h-match" title={M.title} lead={M.lead} />
      <div class="mt" data-mt>
        <ul class="mt__opts" role="list">
          {d.industries.map((it) => (
            <li><a class="mt__btn" href={`#${it.slug}`} data-slug={it.slug}><IndustryIcon slug={it.slug} size={26} /><span>{M.labels[it.slug]}</span></a></li>
          ))}
        </ul>
        <div class="mt__out" aria-live="polite">
          {d.industries.map((it) => (
            <div class="mt__res" data-for={it.slug}>
              <div class="mt__hd"><span class="mt__ico"><IndustryIcon slug={it.slug} size={36} /></span><div><h3>{it.name}</h3><p>{it.promise}</p></div></div>
              <ul class="achips" role="list">
                {apps(it).map((a) => <li><a href={href(lang, `apps/${a.slug}/`)}><AppIcon name={a.slug} size={26} />{short(a.name)}</a></li>)}
              </ul>
              <div class="mt__go">
                <a class="btn btn--wa" href={href(lang, `industries/${it.slug}/`)}>{M.see}</a>
                <a class="textlink" href={`#${it.slug}`}>{M.jump}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={p.cta.title} body={p.cta.body} button={p.cta.button} />
</Base>

<script>
  // Scenes play only when scrolled into view; tabs follow the current row.
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const scenes = [...document.querySelectorAll<HTMLElement>('.irow__scene')];
  if ('IntersectionObserver' in window) {
    const so = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('go'); so.unobserve(e.target); } }), { threshold: 0.3 });
    scenes.forEach((s) => so.observe(s));
    const ro = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          const slug = (e.target as HTMLElement).dataset.row;
          tabs.forEach((t) => t.classList.toggle('is-on', t.dataset.spy === slug));
        }
      });
    }, { rootMargin: '-35% 0px -55% 0px' });
    rows.forEach((r) => ro.observe(r));
  } else scenes.forEach((s) => s.classList.add('go'));

  // Matcher: anchors become toggle buttons.
  const mt = document.querySelector<HTMLElement>('[data-mt]');
  if (mt) {
    mt.classList.add('is-js');
    const btns = [...mt.querySelectorAll<HTMLAnchorElement>('.mt__btn')];
    const res = [...mt.querySelectorAll<HTMLElement>('.mt__res')];
    const pick = (slug: string) => {
      btns.forEach((b) => { const on = b.dataset.slug === slug; b.setAttribute('aria-pressed', String(on)); b.classList.toggle('is-on', on); });
      res.forEach((r) => (r.hidden = r.dataset.for !== slug));
    };
    btns.forEach((b) => {
      b.setAttribute('role', 'button');
      b.addEventListener('click', (e) => { e.preventDefault(); pick(b.dataset.slug!); });
      b.addEventListener('keydown', (e) => { if (e.key === ' ') { e.preventDefault(); pick(b.dataset.slug!); } });
    });
    pick(btns[0].dataset.slug!);
  }
</script>
