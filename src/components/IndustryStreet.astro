---
import { type Lang } from '../lib/site';
// Hero visual for the industries index: six line-art storefronts on one street, thin lines rising into one Odoo node.
// Draw-in with stroke-dashoffset, window lights turn on. CSS/SVG only; reduced motion shows the final state.
const { lang } = Astro.props as { lang: Lang };
const rtl = lang === 'ar';
const xs = [62, 138, 214, 290, 366, 442].map((x) => (rtl ? 480 - x : x));
const GY = 292;
// [paths drawn (local coords, base y=0)], [window lights as x,y,w,h], roof height for the connector
const B = [
  { // retail: shop with awning
    p: ['M-24 0V-44H24V0', 'M-28 -44L-22 -60H22L28 -44Z', 'M-8 -60L-10 -44M8 -60L10 -44', 'M-7 0V-22H7V0'],
    l: [[10, -38, 10, 10], [-20, -38, 8, 10]], h: 62,
  },
  { // wholesale: warehouse
    p: ['M-28 0V-36L0 -54L28 -36V0', 'M-12 0V-24H12V0', 'M-12 -16H12M-12 -8H12'],
    l: [[-4, -40, 8, 6]], h: 56,
  },
  { // manufacturing: factory with chimney
    p: ['M-28 0V-32L-10 -22V-32L8 -22V-46H22V0', 'M12 -46V-70H22V-46', 'M-24 -10H-14M-4 -10H6'],
    l: [[-22, -22, 8, 6], [-2, -34, 8, 6]], h: 72,
  },
  { // services: office tower
    p: ['M-18 0V-88H18V0', 'M-6 0V-12H6V0', 'M-18 -88H18'],
    l: [[-12, -76, 6, 6], [4, -76, 6, 6], [-12, -60, 6, 6], [4, -60, 6, 6], [-12, -44, 6, 6], [4, -44, 6, 6], [-12, -28, 6, 6], [4, -28, 6, 6]], h: 92,
  },
  { // construction: crane + frame
    p: ['M-26 0V-46H4V0', 'M-26 -23H4', 'M20 0V-96', 'M-30 -96H36', 'M-18 -96V-66', 'M20 -96L34 -88'],
    l: [[-20, -38, 8, 8]], h: 100, ghost: true,
  },
  { // restaurant: cafe with cloche sign
    p: ['M-26 0V-36H26V0', 'M-12 -36a12 12 0 0 1 24 0Z', 'M-6 0V-22H6V0', 'M-30 -36H30'],
    l: [[10, -28, 10, 10], [-20, -28, 8, 10]], h: 52,
  },
];
const HUB: [number, number] = [240, 50];
const conn = xs.map((x, i) => {
  const top = GY - B[i].h - 6;
  return `M${x} ${top}Q${x} ${top - 70} ${HUB[0] + (x - HUB[0]) * 0.16} ${HUB[1] + 26}`;
});
---
<div class="stt" aria-hidden="true">
  <svg viewBox="0 0 480 330" focusable="false">
    <path class="stt__ground" d={`M16 ${GY}H464`} />
    <path class="stt__ground stt__ground--d" d={`M40 ${GY + 10}H190M230 ${GY + 10}H440`} />
    {conn.map((d, i) => <path class="stt__wire" pathLength="1" d={d} style={`--i:${i}`} />)}
    {B.map((b, i) => (
      <g transform={`translate(${xs[i]} ${GY})`} style={`--i:${i}`}>
        {b.p.map((d) => <path class="stt__b" pathLength="1" d={d} />)}
        {b.l.map(([x, y, w, h]) => <rect class="stt__lt" x={x} y={y} width={w} height={h} rx="1.5" />)}
      </g>
    ))}
    <g class="stt__hub" transform={`translate(${HUB[0]} ${HUB[1]})`}>
      <circle class="stt__ring" r="34" />
      <circle class="stt__node" r="24" />
      <text y="5" text-anchor="middle">Odoo</text>
    </g>
  </svg>
</div>
