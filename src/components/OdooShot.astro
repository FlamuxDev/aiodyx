---
import { DATA, type Lang } from '../lib/site';
import { SHOT_W, IMG_W, IMG_H, defaultCrop, resolveView, shotSrc, shotSet, type Crop } from '../lib/shots';
// Framed real Odoo screenshot, in the page language: window chrome (three dots + address bar), 1px border, soft shadow.
// Either `view` (a zoomed view with numbered callouts, see lib/shots.ts) or the whole screen `stem` trimmed to its content.
// Frame geometry is physical (the screenshot itself is mirrored by Odoo, not by us); callout text follows the page language.
// Under 640px the chips are replaced by the numbered legend below the frame so nothing overflows.
interface Props {
  lang: Lang;
  alt: string;
  stem?: string;
  view?: string;
  crop?: Crop;
  eager?: boolean;
  bleed?: boolean;
  maxw?: number;
  url?: string;
}
const { lang, alt, stem, view, crop, eager = false, bleed = false, maxw = 1000, url = 'aiodyx.odoo.com' } = Astro.props as Props;
const o = DATA[lang].odoo;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const rv = view ? resolveView(view, lang) : null;
const name = (rv?.stem ?? stem)!;
const c = crop ?? rv?.crop ?? defaultCrop(name);
const points = rv?.points ?? [];
const labels: string[] = view ? ((o.views as Record<string, { callouts: string[] }>)[view]?.callouts ?? []) : [];
const z = SHOT_W / c.w;
const sizes = `(min-width: 900px) ${Math.round(maxw * z)}px, ${Math.round(100 * z)}vw`;
const style = `--ar:${c.w}/${c.h};--iw:${z * 100}%;--il:${(-c.x / c.w) * 100}%;--it:${(-c.y / c.h) * 100}%`;
const pos = (p: { x: number; y: number }) => `left:${((p.x - c.x) / c.w) * 100}%;top:${((p.y - c.y) / c.h) * 100}%`;
const notes = points.map((p, i) => ({ p, t: labels[i] })).filter((n) => n.t);
---
<div class={`oshot ${bleed ? 'oshot--bleed' : ''}`}>
  <div class="oshot__frame">
    <div class="oshot__bar" aria-hidden="true"><i></i><i></i><i></i><span class="oshot__url" dir="ltr">{url}</span></div>
    <div class="oshot__view" style={style} dir="ltr">
      <img src={shotSrc(name, lang)} srcset={shotSet(name, lang)} sizes={sizes} width={IMG_W} height={IMG_H} alt={alt}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" draggable="false" />
      {notes.map((n, i) => (
        <span class="oshot__co" data-side={n.p.side} style={pos(n.p)} aria-hidden="true">
          <i class="oshot__dot">{i + 1}</i>
          <b class="oshot__chip" dir={dir}>{n.t}</b>
        </span>
      ))}
    </div>
  </div>
  {notes.length > 0 && (
    <ol class="oshot__legend" aria-label={o.labels.legend}>
      {notes.map((n, i) => <li><span class="oshot__dot" aria-hidden="true">{i + 1}</span>{n.t}</li>)}
    </ol>
  )}
</div>
