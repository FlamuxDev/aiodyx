---
// Our own flat two-tone app icons (not Odoo's). One coloured rounded square per app, keyed by app slug.
// Glyph parts use white, white at lower opacity, or the badge colour (--c) for cut-outs.
const { name, size = 40, class: cls = '' } = Astro.props as { name: string; size?: number; class?: string };
const C: Record<string, string> = {
  accounting: '#16a34a', 'sales-crm': '#3b6cf6', inventory: '#f97316', purchase: '#0ea5e9', manufacturing: '#ef4444',
  'hr-payroll': '#14b8a6', 'point-of-sale': '#ec4899', 'website-ecommerce': '#f5a30a', 'project-timesheets': '#7b5cf0',
};
const G: Record<string, string> = {
  accounting: '<path d="M12 9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v24l-4-2.4-4 2.4-4-2.4-4 2.4z"/><g fill="var(--c)"><rect x="16" y="12" width="8" height="2.4" rx="1.2"/><rect x="16" y="17.5" width="8" height="2.4" rx="1.2"/><rect x="16" y="23" width="5" height="2.4" rx="1.2"/></g>',
  'sales-crm': '<circle cx="20" cy="20" r="12.5"/><circle cx="20" cy="20" r="8.4" fill="var(--c)"/><circle cx="20" cy="20" r="5"/><circle cx="20" cy="20" r="1.8" fill="var(--c)"/>',
  inventory: '<path d="M20 7.5l11 6.2-11 6.3-11-6.3z"/><path d="M9 13.7l11 6.3v12.5L9 26.2z" fill-opacity=".62"/><path d="M31 13.7L20 20v12.5l11-6.3z" fill-opacity=".82"/>',
  purchase: '<path d="M10.5 15.5h19l-1.6 14.6a2.2 2.2 0 0 1-2.2 2H14.3a2.2 2.2 0 0 1-2.2-2z"/><path d="M15.5 15.5V13a4.5 4.5 0 0 1 9 0v2.5" fill="none" stroke="var(--ai-fg,#0e6b5c)" stroke-opacity=".62" stroke-width="2.6" stroke-linecap="round"/>',
  manufacturing: '<g transform="translate(20 20)"><circle r="9"/><rect x="-2.6" y="-13.5" width="5.2" height="27" rx="1.6"/><rect x="-2.6" y="-13.5" width="5.2" height="27" rx="1.6" transform="rotate(45)"/><rect x="-2.6" y="-13.5" width="5.2" height="27" rx="1.6" transform="rotate(90)"/><rect x="-2.6" y="-13.5" width="5.2" height="27" rx="1.6" transform="rotate(135)"/><circle r="3.8" fill="var(--c)"/></g>',
  'hr-payroll': '<circle cx="26.5" cy="14.5" r="3.8" fill-opacity=".62"/><path d="M22 31c0-4.6 2.3-8.4 6.8-8.4 3.2 0 5.7 2.6 5.7 8.4z" fill-opacity=".62"/><circle cx="16" cy="14" r="5"/><path d="M6.5 32c0-5.9 4.2-10 9.5-10s9.5 4.1 9.5 10z"/>',
  'point-of-sale': '<rect x="11" y="7" width="18" height="26" rx="3.2"/><rect x="14.2" y="10.2" width="11.6" height="6.4" rx="1.6" fill="var(--c)"/><g fill="var(--c)"><circle cx="15.5" cy="21.5" r="1.4"/><circle cx="20" cy="21.5" r="1.4"/><circle cx="24.5" cy="21.5" r="1.4"/><circle cx="15.5" cy="26" r="1.4"/><circle cx="20" cy="26" r="1.4"/><circle cx="24.5" cy="26" r="1.4"/></g>',
  'website-ecommerce': '<circle cx="20" cy="20" r="12.5"/><g fill="none" stroke="var(--c)" stroke-width="2"><ellipse cx="20" cy="20" rx="5.2" ry="12.5"/><path d="M7.5 20h25"/></g>',
  'project-timesheets': '<circle cx="20" cy="20" r="12.5"/><path d="M20 12.5V20.4l5.4 3.1" fill="none" stroke="var(--c)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---
<svg class={`app-icon ${cls}`} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" style="--c:var(--ai-bg,#e8f3f0)">
  <rect width="40" height="40" rx="8" fill="var(--c)" />
  <g fill="var(--ai-fg,#0e6b5c)" set:html={G[name] ?? G.accounting} />
</svg>
