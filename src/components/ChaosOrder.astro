---
import Icon from './Icon.astro';
// Home "chaos to order": the four problems start scattered and tilted among dashed tangled lines, and as the block scrolls
// into view they dissolve into an ordered, connected column of the four Odoo benefits. CSS scroll-driven animation
// (--p 0..1) with a JS tween fallback. Reduced motion: final ordered state, problems listed above.
const { bad, good } = Astro.props as { bad: { title: string; body: string }[]; good: { title: string; body: string }[] };
const off = [[3, -22, -4], [30, 22, 3], [9, -24, -2], [27, 20, 4]]; // [inline offset %, vertical px, tilt deg]
---
<div class="co" data-co>
  <svg class="co__tangle" aria-hidden="true" viewBox="0 0 400 520" preserveAspectRatio="none"><path d="M30 70C140 20 120 190 250 120S350 250 380 140M20 300C120 380 220 230 330 330S300 450 120 480M60 200C150 250 230 150 340 220" /></svg>
  <div class="co__spine" aria-hidden="true"></div>
  <ul class="co__plist" aria-hidden="true">{bad.map((b) => <li>{b.title}</li>)}</ul>
  <ol class="co__list" role="list">
    {good.map((g, i) => (
      <li class="co__item" style={`--bx:${off[i][0]};--dy:${off[i][1]};--r:${off[i][2]}`}>
        <div class="co__bad" aria-hidden="true"><span class="x"><Icon name="close" size={14} /></span><div><strong>{bad[i].title}</strong><p>{bad[i].body}</p></div></div>
        <div class="co__good"><span class="ok"><Icon name="check" size={15} /></span><div><strong>{g.title}</strong><p>{g.body}</p></div></div>
      </li>
    ))}
  </ol>
</div>
<script>
  const co = document.querySelector<HTMLElement>('[data-co]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (co && !reduce && !CSS.supports('animation-timeline: view()') && 'IntersectionObserver' in window) {
    co.style.setProperty('--p', '0');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1500);
        co.style.setProperty('--p', String(1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.35 });
    io.observe(co);
  }
</script>
