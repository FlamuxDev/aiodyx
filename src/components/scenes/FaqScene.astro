---
// Compact stack of question cards, one opened to show an answer.
export interface Props { lang: 'ar' | 'en' | string }
const { lang } = Astro.props;
const rtl = lang === 'ar';
const t = rtl
  ? { q: 'كم تاخذ مدة التطبيق؟', a: 'غالباً من 4 إلى 8 أسابيع، وتختلف حسب حجم شغلك.' }
  : { q: 'How long does setup take?', a: 'Usually 4 to 8 weeks, depending on the size of your business.' };
---
<div class="scene" aria-hidden="true" dir={rtl ? 'rtl' : 'ltr'}>
  <div class="stack">
    <div class="badge" style="--d:.9s"><span>?</span></div>
    <div class="card c1" style="--d:.1s">
      <i class="sk" style="width:58%"></i><b class="plus"></b>
    </div>
    <div class="card open" style="--d:.35s">
      <div class="head"><strong>{t.q}</strong><b class="minus"></b></div>
      <p>{t.a}</p>
      <div class="foot"><i class="sk" style="width:36%"></i></div>
    </div>
    <div class="card c3" style="--d:.6s">
      <i class="sk" style="width:48%"></i><b class="plus"></b>
    </div>
  </div>
</div>

<style>
  .scene { width: 100%; max-width: 420px; margin-inline: auto; font-family: var(--font); }
  .stack { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 44px 8px 18px; }
  .card { background: #fff; border: 1.5px solid var(--line-2); border-radius: 14px; padding: 16px 18px; display: flex; align-items: center; justify-content: space-between; gap: 14px; opacity: 0; animation: rise .7s ease-out forwards; animation-delay: var(--d, 0s); box-shadow: 0 10px 20px -16px rgba(21, 32, 29, .35); }
  .c1 { margin-inline-start: 22px; margin-inline-end: 0; padding-top: 22px; }
  .c3 { margin-inline-end: 22px; }
  .open { display: block; border-color: var(--primary); background: #fff; padding: 18px 20px 16px; box-shadow: 0 18px 30px -20px rgba(14, 107, 92, .45); }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .head strong { font-size: 15.5px; font-weight: 600; color: var(--ink); line-height: 1.5; }
  .open p { margin: 10px 0 12px; padding-top: 10px; border-top: 1.5px solid var(--line); font-size: 14px; line-height: 1.7; color: var(--muted); }
  .foot { display: flex; }
  .sk { display: block; height: 8px; border-radius: 4px; background: var(--line); }
  .plus, .minus { position: relative; flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--primary-soft); }
  .plus::before, .minus::before { content: ''; position: absolute; inset: 11px 7px auto; height: 1.5px; background: var(--primary); }
  .plus::after { content: ''; position: absolute; inset: 7px auto 7px 11px; width: 1.5px; background: var(--primary); }
  .badge { position: absolute; inset-block-start: 0; inset-inline-end: 20px; z-index: 2; width: 54px; height: 54px; border-radius: 50%; background: var(--primary); display: grid; place-items: center; box-shadow: 0 0 0 7px var(--primary-soft); opacity: 0; animation: pop .7s ease-out forwards; animation-delay: var(--d, 0s); }
  .badge span { color: #fff; font-size: 26px; font-weight: 600; line-height: 1; }
  .badge { transform-origin: center; }
  .badge::after { content: ''; position: absolute; inset: -7px; border-radius: 50%; border: 1.5px solid var(--mint); opacity: 0; animation: ping 3.4s ease-out 2s infinite; }

  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes pop { from { opacity: 0; transform: scale(.8); } to { opacity: 1; transform: none; } }
  @keyframes ping { 0% { transform: scale(1); opacity: .6; } 100% { transform: scale(1.5); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; }
    .card, .badge { opacity: 1; }
  }
</style>
