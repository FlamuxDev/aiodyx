---
// In-house review tool. Reviewers switch on review mode, select text or pin any element, and leave notes
// that live in threads. Everything talks to the feedback worker (worker/feedback.js); the heavy logic is
// loaded lazily from src/scripts/feedback*.ts only while review mode is on.
// The tool renders only when PUBLIC_FEEDBACK_URL is set at build time.
import type { Lang } from '../lib/site';
import '../styles/feedback.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FEEDBACK_URL;
const T = lang === 'ar'
  ? {
      fab: 'ملاحظات', exit: 'إنهاء المراجعة', bar: 'أدوات المراجعة',
      hintPin: 'حدّد نصًّا أو انقر على أي عنصر لإضافة ملاحظة. اضغط Ctrl مع النقر لفتح الرابط.',
      hintText: 'حدّد نصًّا لإضافة ملاحظة. الروابط تعمل بشكل طبيعي.',
      list: 'قائمة الملاحظات', general: 'ملاحظة عامة', pin: 'تثبيت على العناصر',
      add: 'أضف ملاحظة', title: 'ملاحظة جديدة', quote: 'النص المحدد', element: 'العنصر المحدد', generalQuote: 'ملاحظة على الصفحة كاملة',
      note: 'الملاحظة', notePh: 'اكتب ملاحظتك: ما المطلوب تعديله، والصياغة المقترحة إن وجدت.', name: 'الاسم', namePh: 'اختياري',
      shot: 'إرفاق لقطة للشاشة', send: 'إرسال', cancel: 'إلغاء', close: 'إغلاق',
      panel: 'الملاحظات', thisPage: 'هذه الصفحة', allPages: 'كل الصفحات',
      fOpen: 'مفتوحة', fResolved: 'محلولة', fAll: 'الكل',
      loading: 'جارٍ التحميل…', loadFailed: 'تعذّر تحميل الملاحظات.', retry: 'إعادة المحاولة', empty: 'لا توجد ملاحظات هنا.',
      detached: 'النص تغيّر', pending: 'جارٍ الإرسال…', sendFailed: 'تعذّر الإرسال. نصّك محفوظ.', discard: 'حذف المسودة',
      reply: 'ردّ', replyPh: 'اكتب ردًّا…', sendReply: 'إرسال الرد', resolve: 'وسم كمحلولة', reopen: 'إعادة فتح',
      edit: 'تعديل', del: 'حذف', confirmDel: 'تأكيد الحذف', save: 'حفظ', edited: 'معدّلة', goto: 'الانتقال إلى الموضع', openPage: 'فتح الصفحة',
      anon: 'زائر', you: 'أنت', pageNote: 'ملاحظة عامة', pinLabel: 'ملاحظة', shotAlt: 'لقطة الشاشة',
      now: 'الآن', saved: 'تم حفظ الملاحظة.', failed: 'تعذّر تنفيذ الطلب. حاول مرة أخرى.', deleted: 'تم الحذف.', sending: 'جارٍ الإرسال…',
      replies: { zero: 'لا ردود', one: 'ردّ واحد', two: 'ردّان', few: '{n} ردود', many: '{n} ردًّا', other: '{n} رد' },
    }
  : {
      fab: 'Notes', exit: 'Exit review', bar: 'Review tools',
      hintPin: 'Select text or click any element to add a note. Hold Ctrl while clicking to follow a link.',
      hintText: 'Select text to add a note. Links work normally.',
      list: 'Notes list', general: 'General note', pin: 'Pin to elements',
      add: 'Add note', title: 'New note', quote: 'Selected text', element: 'Selected element', generalQuote: 'Note on the whole page',
      note: 'Note', notePh: 'Describe what should change, and suggested wording if any.', name: 'Name', namePh: 'Optional',
      shot: 'Attach a screenshot', send: 'Send', cancel: 'Cancel', close: 'Close',
      panel: 'Notes', thisPage: 'This page', allPages: 'All pages',
      fOpen: 'Open', fResolved: 'Resolved', fAll: 'All',
      loading: 'Loading…', loadFailed: 'Could not load the notes.', retry: 'Retry', empty: 'No notes here.',
      detached: 'Text changed', pending: 'Sending…', sendFailed: 'Could not send. Your text is kept.', discard: 'Discard draft',
      reply: 'Reply', replyPh: 'Write a reply…', sendReply: 'Send reply', resolve: 'Mark resolved', reopen: 'Reopen',
      edit: 'Edit', del: 'Delete', confirmDel: 'Confirm delete', save: 'Save', edited: 'edited', goto: 'Go to location', openPage: 'Open page',
      anon: 'Visitor', you: 'you', pageNote: 'General note', pinLabel: 'Note', shotAlt: 'Screenshot',
      now: 'just now', saved: 'Note saved.', failed: 'Request failed. Please try again.', deleted: 'Deleted.', sending: 'Sending…',
      replies: { zero: 'No replies', one: '1 reply', other: '{n} replies' },
    };
const icon = (d: string) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
{endpoint && (
  <div class="fb" data-endpoint={endpoint} data-lang={lang} data-t={JSON.stringify(T)}>
    <div class="fb__bar" hidden role="region" aria-label={T.bar}>
      <p class="fb__hint" data-hint-pin={T.hintPin} data-hint-text={T.hintText}></p>
      <div class="fb__tools">
        <button type="button" class="fb__tool" data-fb="list" aria-expanded="false" aria-controls="fb-panel"><Fragment set:html={icon('<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />')} />{T.list}</button>
        <button type="button" class="fb__tool" data-fb="general">{T.general}</button>
        <button type="button" class="fb__tool" data-fb="pin" aria-pressed="true">{T.pin}</button>
      </div>
    </div>

    <button type="button" class="fb__fab" aria-pressed="false" data-on={T.exit} data-off={T.fab}>
      <Fragment set:html={icon('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /><path d="M8 9h8M8 13h5" />')} />
      <span class="fb__fab-label">{T.fab}</span>
      <b class="fb__badge" hidden></b>
    </button>

    <button type="button" class="fb__chip" hidden>{T.add}</button>
    <div class="fb__ring" hidden aria-hidden="true"></div>
    <div class="fb__pins"></div>

    <aside class="fb__panel" id="fb-panel" hidden tabindex="-1" aria-labelledby="fb-panel-title">
      <header class="fb__panel-head">
        <h2 id="fb-panel-title">{T.panel}</h2>
        <button type="button" class="fb__x" data-fb="panel-close" aria-label={T.close}><Fragment set:html={icon('<path d="M18 6 6 18M6 6l12 12" />')} /></button>
      </header>
      <div class="fb__filters">
        <div class="fb__seg" role="group" aria-label={T.panel}>
          <button type="button" data-filter="open" aria-pressed="true">{T.fOpen}</button>
          <button type="button" data-filter="resolved" aria-pressed="false">{T.fResolved}</button>
          <button type="button" data-filter="all" aria-pressed="false">{T.fAll}</button>
        </div>
        <div class="fb__seg" role="group" aria-label={T.panel}>
          <button type="button" data-scope="page" aria-pressed="true">{T.thisPage}</button>
          <button type="button" data-scope="all" aria-pressed="false">{T.allPages}</button>
        </div>
      </div>
      <div class="fb__list" data-fb="items"></div>
    </aside>

    <dialog class="fb__dialog" aria-labelledby="fb-title">
      <form method="dialog" class="fb__form">
        <h2 id="fb-title">{T.title}</h2>
        <p class="fb__label" data-fb="quote-label"></p>
        <blockquote class="fb__quote"></blockquote>
        <label>{T.note}<textarea name="note" rows="5" required maxlength="5000" placeholder={T.notePh}></textarea></label>
        <label>{T.name}<input name="name" maxlength="80" autocomplete="name" placeholder={T.namePh} /></label>
        <label class="fb__check"><input type="checkbox" name="shot" checked />{T.shot}</label>
        <input class="fb__hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="fb__actions">
          <button type="submit" class="fb__btn fb__btn--primary">{T.send}</button>
          <button type="button" class="fb__btn" data-fb="cancel">{T.cancel}</button>
        </div>
      </form>
    </dialog>

    <p class="fb__toast" role="status" aria-live="polite" hidden></p>
  </div>
)}

<script>
  import '../scripts/feedback';
</script>
